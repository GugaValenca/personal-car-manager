# Copy this file to `.env` for local development and fill in real values in
# your deploy provider's dashboard (e.g. Vercel > Project > Settings >
# Environment Variables) for production. Never commit a real .env file.

# Required in production (DJANGO_DEBUG=False). Locally it falls back to an
# insecure development-only key so you don't need to set this to run the app.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Defaults to False (safe). Set to True only for local development.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Optional: force HTTP -> HTTPS redirects in production (default True when
# DEBUG=False). Set to False only if TLS termination is handled elsewhere.
DJANGO_SECURE_SSL_REDIRECT=True

# Optional: HSTS max-age in seconds applied in production (default 3600).
DJANGO_HSTS_SECONDS=3600

# Optional. If unset, the app uses a local SQLite file (fine for development,
# NOT fine for Vercel's serverless deploys, whose filesystem is ephemeral and
# will lose data between deploys). Point this at a managed Postgres instance
# (e.g. Neon, Supabase, Vercel Postgres) for any real deployment:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
